# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_development_guild_id_here

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://panelcord:panelcord_password@localhost:5432/panelcord?schema=public

# Application Environment (development, test, production)
NODE_ENV=development

# Logging Level (fatal, error, warn, info, debug, trace)
LOG_LEVEL=info

# Pterodactyl Security Configuration
# Default is false (denies loopback, RFC 1918, and private addresses for multi-tenant SSRF protection).
# Set to true only for self-hosted / home-lab deployments connecting to local internal panels.
# Untrusted Discord users cannot override this host-level setting.
PTERODACTYL_ALLOW_PRIVATE_NETWORKS=false

# Master Encryption Key (AES-256-GCM)
# 32-byte hexadecimal string used to encrypt Pterodactyl Client API keys at rest.
# Generate securely via terminal: openssl rand -hex 32
# CRITICAL: Losing this key permanently renders all stored credentials unrecoverable!
PANELCORD_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
